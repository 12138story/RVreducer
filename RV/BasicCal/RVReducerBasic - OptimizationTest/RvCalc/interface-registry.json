{
  "version": 1,
  "note": "RVReducerBasic.dll 导出函数的语义化描述表。所有槽位下标来自 C++ 源码 RVReducerBasic/InterfaceForCSharp.cpp 及各 Convert* 函数；单位以 DLL 实际期望为准。新增接口只需在此登记，无需改 C# 代码。",
  "interfaces": [
    {
      "name": "CalBearingLife",
      "title": "标准轴承寿命计算",
      "summary": "按轴承类型与轴向力 Fa、径向力 Fr 计算基本额定寿命 L10h（内部按类型选用系数与数据库）。",
      "returns": "void",
      "complexity": "low",
      "note": "力矩/载荷单位以 N 为准（数据库里的 kN 值需 ×1000 后传入）。",
      "args": [
        { "name": "in", "type": "double", "length": 9, "direction": "in" },
        { "name": "out", "type": "double", "length": 20, "direction": "out" }
      ],
      "params": [
        { "name": "轴承类型", "alias": ["type", "BearingType"], "slot": "in[0]", "type": "enum", "required": true,
          "options": { "深沟球轴承": 1001, "滚针轴承": 1002, "圆锥滚子轴承": 1003, "角接触球轴承": 1004 },
          "desc": "取值来自 C++ PreDefine.h（1001/1002/1003/1004）；圆锥滚子额外用 e、Y、Y0，角接触球由 Fa/C0r 反查 e、Y" },
        { "name": "转速", "alias": ["speed", "n", "rpm"], "slot": "in[1]", "unit": "r/min", "required": true },
        { "name": "轴向力Fa", "alias": ["Fa", "axial"], "slot": "in[2]", "unit": "N", "default": 0 },
        { "name": "径向力Fr", "alias": ["Fr", "radial"], "slot": "in[3]", "unit": "N", "default": 0 },
        { "name": "额定动载荷Cr", "alias": ["Cr", "C"], "slot": "in[4]", "unit": "N", "required": true },
        { "name": "额定静载荷C0r", "alias": ["C0r", "C0"], "slot": "in[5]", "unit": "N", "required": true },
        { "name": "系数e", "alias": ["e"], "slot": "in[6]" },
        { "name": "系数Y", "alias": ["Y"], "slot": "in[7]" },
        { "name": "系数Y0", "alias": ["Yo", "Y0"], "slot": "in[8]" }
      ],
      "outputs": [
        { "name": "寿命L10h", "slot": "out[0]", "unit": "h", "invalidBelow": 0,
          "desc": "≤0 表示计算失败（转速越界、fh 超出曲线定义域等）" }
      ]
    },
    {
      "name": "CalCustomBearingLife",
      "title": "自定义/ISO 修正轴承寿命计算",
      "summary": "输入自定义轴承几何与工况，输出静强度、基本额定寿命与 ISO 修正寿命（37 输入 → 20 输出）。",
      "returns": "int",
      "complexity": "medium",
      "note": "返回 0 成功，-1/-2 异常。类型码 0=深沟球 1=角接触 2=调心球 3=向心滚子(含圆锥/滚针/调心滚子，由 InData[13] 开关) 4..7=推力类。",
      "args": [
        { "name": "in", "type": "double", "length": 37, "direction": "in" },
        { "name": "out", "type": "double", "length": 20, "direction": "out" }
      ],
      "params": [
        { "name": "轴承类型码", "alias": ["typeCode"], "slot": "in[0]", "type": "enum", "required": true,
          "options": { "深沟球轴承": 0, "角接触球轴承": 1, "调心球轴承": 2, "向心滚子轴承": 3, "90度推力球": 4, "非90度推力球": 5, "90度推力滚子": 6, "非90度推力滚子": 7 } },
        { "name": "布置方式", "alias": ["layout"], "slot": "in[1]", "default": 0 },
        { "name": "排列个数", "alias": ["assemblyCount"], "slot": "in[2]", "default": 1 },
        { "name": "额定动载荷Cr", "alias": ["Cr", "C"], "slot": "in[3]", "unit": "N", "required": true },
        { "name": "额定静载荷C0r", "alias": ["C0r", "C0"], "slot": "in[4]", "unit": "N", "required": true },
        { "name": "节圆直径Dpw", "alias": ["Dpw"], "slot": "in[5]", "unit": "mm" },
        { "name": "滚动体直径Dw", "alias": ["Dw"], "slot": "in[6]", "unit": "mm" },
        { "name": "接触角", "alias": ["alpha"], "slot": "in[7]", "unit": "°" },
        { "name": "列数", "alias": ["rows"], "slot": "in[8]", "default": 1 },
        { "name": "滚动体个数Z", "alias": ["Z"], "slot": "in[9]" },
        { "name": "动载荷修正系数bm", "alias": ["bm"], "slot": "in[10]", "default": 1 },
        { "name": "滚子总长Lwe", "alias": ["L_total", "Lwe"], "slot": "in[11]", "unit": "mm" },
        { "name": "滚子倒角r", "alias": ["r"], "slot": "in[12]", "unit": "mm" },
        { "name": "滚子子类型", "slot": "in[13]", "type": "enum", "options": { "无": 0, "圆锥滚子": 1, "冲压滚针": 2, "调心滚子": 3 } },
        { "name": "圆锥角", "alias": ["beta"], "slot": "in[14]", "unit": "°" },
        { "name": "大端倒角rl", "slot": "in[15]", "unit": "mm" },
        { "name": "小端倒角rs", "slot": "in[16]", "unit": "mm" },
        { "name": "启用样本覆写", "slot": "in[17]", "type": "enum", "options": { "否": 0, "是": 1 } },
        { "name": "样本e", "slot": "in[18]" },
        { "name": "样本X1", "slot": "in[20]" },
        { "name": "样本Y1", "slot": "in[21]" },
        { "name": "径向力Fr", "alias": ["Fr"], "slot": "in[28]", "unit": "N", "default": 0 },
        { "name": "轴向力Fa", "alias": ["Fa"], "slot": "in[29]", "unit": "N", "default": 0 },
        { "name": "转速", "alias": ["n", "rpm"], "slot": "in[30]", "unit": "r/min", "required": true },
        { "name": "润滑黏度v", "slot": "in[32]", "unit": "mm2/s" },
        { "name": "污染等级", "slot": "in[33]", "type": "enum", "options": { "极洁净": 0, "洁净": 1, "一般": 2, "污染": 3, "严重污染": 4 } },
        { "name": "油膜参数lambda", "slot": "in[34]" },
        { "name": "含极压添加剂", "slot": "in[35]", "type": "enum", "options": { "否": 0, "是": 1 } },
        { "name": "可靠度", "slot": "in[36]", "default": 0.9 }
      ],
      "outputs": [
        { "name": "结果标识", "slot": "out[0]", "desc": "1=成功" },
        { "name": "基本额定静载荷C0", "slot": "out[1]", "unit": "N" },
        { "name": "静载荷系数f0", "slot": "out[2]" },
        { "name": "当量静载荷P0", "slot": "out[3]", "unit": "N" },
        { "name": "静强度安全系数S0", "slot": "out[4]", "invalidBelow": 0 },
        { "name": "额定动载荷C", "slot": "out[5]", "unit": "N" },
        { "name": "动载荷系数X", "slot": "out[6]" },
        { "name": "动载荷系数Y", "slot": "out[7]" },
        { "name": "当量动载荷P", "slot": "out[8]", "unit": "N" },
        { "name": "基本额定寿命L10r", "slot": "out[9]", "unit": "10^6转" },
        { "name": "基本额定寿命L10h", "slot": "out[10]", "unit": "h", "invalidBelow": 0 },
        { "name": "黏度比kappa", "slot": "out[11]" },
        { "name": "污染系数ec", "slot": "out[12]" },
        { "name": "可靠度修正系数a1", "slot": "out[13]" },
        { "name": "系统修正系数a_iso", "slot": "out[14]" },
        { "name": "修正额定寿命Lnm", "slot": "out[15]", "unit": "10^6转" },
        { "name": "滚子有效长度Lwe", "slot": "out[16]", "unit": "mm" },
        { "name": "轴向力Fa", "slot": "out[17]", "unit": "N" },
        { "name": "径向力Fr", "slot": "out[18]", "unit": "N" },
        { "name": "转速n", "slot": "out[19]", "unit": "r/min" }
      ]
    },
    {
      "name": "RecommondBearingLife",
      "title": "轴承推荐（按寿命挑型）",
      "summary": "按轴承类型遍历轴承数据库，返回满足寿命要求/候选的轴承列表（含内径、外径、宽度、Cr、C0r、寿命）。",
      "returns": "int",
      "complexity": "medium",
      "note": "返回值 = 命中条数；每条记录 9 个字段（圆锥滚子：d/D/B/Cr/C0r/e/Y/Yo/life），其它类型 6 个字段（d/D/B/Cr/C0r/life）。",
      "args": [
        { "name": "in", "type": "double", "length": 10, "direction": "in" },
        { "name": "out", "type": "double", "length": 900, "direction": "out" },
        { "name": "codes", "type": "strings", "direction": "out", "maxCount": 100, "maxLen": 64 }
      ],
      "params": [
        { "name": "轴承类型", "alias": ["type"], "slot": "in[0]", "type": "enum", "required": true,
          "options": { "圆锥滚子轴承": 1003, "角接触球轴承": 1004, "深沟球轴承": 1001, "滚针轴承": 1002 } },
        { "name": "转速", "alias": ["n", "rpm"], "slot": "in[1]", "unit": "r/min", "required": true },
        { "name": "轴向力Fa", "alias": ["Fa"], "slot": "in[2]", "unit": "N", "default": 0 },
        { "name": "径向力Fr", "alias": ["Fr"], "slot": "in[3]", "unit": "N", "default": 0 },
        { "name": "额定动载荷Cr", "alias": ["Cr"], "slot": "in[4]", "unit": "N", "default": 0 },
        { "name": "额定静载荷C0r", "alias": ["C0r"], "slot": "in[5]", "unit": "N", "default": 0 },
        { "name": "系数e", "slot": "in[6]" },
        { "name": "系数Y", "slot": "in[7]" },
        { "name": "系数Y0", "slot": "in[8]" }
      ],
      "outputs": [
        { "name": "命中条数", "slot": "in[0]", "desc": "见返回值" }
      ]
    },
    {
      "name": "RecommondMainBearing",
      "title": "主轴承推荐（曲轴支承轴承）",
      "summary": "给定渐开线齿轮受力与许用弯曲/剪应力，遍历轴承库选出满足轴强度与寿命的主轴承，返回内径、轴长与轴承参数。",
      "returns": "void",
      "complexity": "high",
      "note": "输入段 [0..6] 为渐开线齿轮受力/位置数据（与 AssemblyGearAndMainBearing 共用），必须由完整齿轮算例提供；输出 [0]/[1] 是先写入的应力校核值，找到解后会被 推荐内径/轴长 覆盖。",
      "args": [
        { "name": "in", "type": "double", "length": 16, "direction": "in" },
        { "name": "out", "type": "double", "length": 32, "direction": "out" }
      ],
      "params": [
        { "name": "轴承类型开关", "alias": ["typeFlag"], "slot": "in[7]", "type": "enum", "required": true,
          "options": { "圆锥滚子轴承": 0, "角接触球轴承": 1 } },
        { "name": "转速", "alias": ["n", "rpm"], "slot": "in[8]", "unit": "r/min", "required": true },
        { "name": "许用弯曲应力", "slot": "in[9]", "unit": "MPa", "required": true },
        { "name": "许用剪应力", "slot": "in[10]", "unit": "MPa", "required": true },
        { "name": "设计寿命", "slot": "in[11]", "unit": "h", "required": true },
        { "name": "齿轮位置", "slot": "in[6]", "unit": "mm" }
      ],
      "outputs": [
        { "name": "推荐轴承内径d", "slot": "out[0]", "unit": "mm", "invalidBelow": 0, "desc": "-1 表示未找到合适轴承" },
        { "name": "推荐轴长", "slot": "out[1]", "unit": "mm", "invalidBelow": 0 },
        { "name": "轴承外径D", "slot": "out[9]", "unit": "mm" },
        { "name": "轴承宽度T/B", "slot": "out[10]", "unit": "mm" },
        { "name": "额定动载荷Cr", "slot": "out[13]", "unit": "N" },
        { "name": "额定静载荷C0r", "slot": "out[14]", "unit": "N" },
        { "name": "系数e", "slot": "out[15]" },
        { "name": "系数Y", "slot": "out[16]" },
        { "name": "系数Y0", "slot": "out[17]" },
        { "name": "定位面距基准距离1", "slot": "out[3]", "unit": "mm" },
        { "name": "定位面距基准距离2", "slot": "out[6]", "unit": "mm" },
        { "name": "轴承类型码", "slot": "out[20]" }
      ]
    },
    {
      "name": "CalTotalTorqueAndRPM",
      "title": "总体传动比与力矩/转速分配",
      "summary": "由整机输出力矩/转速与各级齿数，计算一级输入力矩、一级小齿轮转速、二级输出力矩与二级轴承转速。",
      "returns": "void",
      "complexity": "low",
      "args": [
        { "name": "in", "type": "double", "length": 8, "direction": "in" },
        { "name": "out", "type": "double", "length": 8, "direction": "out" }
      ],
      "params": [
        { "name": "固定件", "alias": ["fixElem"], "slot": "in[0]", "type": "enum", "required": true,
          "options": { "针齿壳固定": 0, "曲轴固定": 1 } },
        { "name": "输出力矩", "alias": ["outputTorque"], "slot": "in[1]", "unit": "N·m", "required": true },
        { "name": "输出转速", "alias": ["outputRPM"], "slot": "in[2]", "unit": "r/min", "required": true },
        { "name": "太阳轮齿数", "slot": "in[3]", "required": true },
        { "name": "行星轮齿数", "slot": "in[4]", "required": true },
        { "name": "摆线轮齿数", "slot": "in[5]", "required": true },
        { "name": "针轮齿数", "slot": "in[6]", "required": true }
      ],
      "outputs": [
        { "name": "一级输入力矩", "slot": "out[0]", "unit": "N·m" },
        { "name": "一级小齿轮转速", "slot": "out[1]", "unit": "r/min" },
        { "name": "二级输出力矩", "slot": "out[2]", "unit": "N·m" },
        { "name": "二级轴承转速", "slot": "out[3]", "unit": "r/min" }
      ]
    },
    {
      "name": "RecommondPara",
      "title": "整机齿轮参数推荐",
      "summary": "由固定件、总传动比、输出力矩/转速、目标接触应力、寿命、使用系数、许用应力与行星轮个数，推荐渐开线齿轮副 + 摆线针轮副的全部主要参数。",
      "returns": "void",
      "complexity": "medium",
      "note": "输出 0..8 为齿轮副公共参数，9..39 太阳轮 31 字段，40..70 行星轮 31 字段，71..76 针轮，77..88 两个摆线轮，89/90 一级输入力矩/转速。",
      "args": [
        { "name": "in", "type": "double", "length": 12, "direction": "in" },
        { "name": "out", "type": "double", "length": 91, "direction": "out" }
      ],
      "params": [
        { "name": "固定件", "alias": ["fixElem"], "slot": "in[0]", "type": "enum", "required": true,
          "options": { "针齿壳固定": 0, "曲轴固定": 1 } },
        { "name": "总传动比", "alias": ["totalRatio", "ratio"], "slot": "in[1]", "required": true },
        { "name": "输出力矩", "alias": ["outputTorque"], "slot": "in[2]", "unit": "N·m", "required": true },
        { "name": "输出转速", "alias": ["outputRPM"], "slot": "in[3]", "unit": "r/min", "required": true },
        { "name": "目标接触应力", "alias": ["targetStress"], "slot": "in[4]", "unit": "MPa", "default": 1000 },
