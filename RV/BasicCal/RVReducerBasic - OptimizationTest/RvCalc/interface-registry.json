    {
      "name": "CalInvGearStress2",
      "title": "渐开线齿轮副几何与强度计算（ISO 6336）",
      "summary": "输入 174 字段齿轮副全参数（几何/材料/加工/应用/公差/载荷/装配/定位），输出太阳轮与行星轮各 142 字段（应力、几何、重合度、载荷系数等）。",
      "returns": "void",
      "complexity": "medium",
      "note": "长度 174 输入 + 34 分割索引；模板见 templates/invGearStress2.json（由 InvGearInput 生成，与已有算例一致）。压力角/螺旋角按角度输入，内部自动转弧度。",
      "args": [
        { "name": "div", "type": "int", "length": 34, "direction": "in" },
        { "name": "in", "type": "double", "length": 174, "direction": "in" },
        { "name": "out", "type": "double", "length": 284, "direction": "out" }
      ],
      "templateFile": "templates/invGearStress2.json",
      "outRowWidth": 142,
      "rowLabels": ["太阳轮", "行星轮"],
      "params": [
        { "name": "太阳轮齿数", "alias": ["sunTeeth", "z1"], "slot": "in[0]", "required": true },
        { "name": "太阳轮设计齿宽", "alias": ["sunWidth", "b1"], "slot": "in[2]", "unit": "mm" },
        { "name": "太阳轮变位系数", "alias": ["x1"], "slot": "in[4]" },
        { "name": "太阳轮齿厚偏差上限", "alias": ["Esns1"], "slot": "in[15]", "unit": "mm" },
