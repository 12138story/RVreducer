      ],
      "outputs": [
        { "name": "法向模数mn", "slot": "out[0]", "unit": "mm" },
        { "name": "压力角αn", "slot": "out[1]", "unit": "°" },
        { "name": "螺旋角β", "slot": "out[2]", "unit": "°" },
        { "name": "中心距a_w", "slot": "out[3]", "unit": "mm" },
        { "name": "齿轮副类型", "slot": "out[4]" },
        { "name": "行星轮个数n_P", "slot": "out[5]" },
        { "name": "驱动齿轮", "slot": "out[6]" },
        { "name": "触点间隙j_bn", "slot": "out[7]" },
        { "name": "主动轮转速n0", "slot": "out[8]", "unit": "r/min" },
        { "name": "太阳轮齿数Z", "slot": "out[9]" },
        { "name": "太阳轮设计齿宽b", "slot": "out[11]", "unit": "mm" },
        { "name": "太阳轮变位系数x", "slot": "out[13]" },
        { "name": "行星轮齿数Z", "slot": "out[40]" },
        { "name": "行星轮设计齿宽b", "slot": "out[42]", "unit": "mm" },
        { "name": "针轮齿数Z", "slot": "out[71]" },
        { "name": "滚针半径rz", "slot": "out[72]", "unit": "mm" },
        { "name": "针轮设计齿宽", "slot": "out[73]", "unit": "mm" },
        { "name": "针轮分度圆半径Rzf", "slot": "out[74]", "unit": "mm" },
        { "name": "使用系数Kp", "slot": "out[76]" },
        { "name": "摆线轮1齿数", "slot": "out[77]" },
        { "name": "偏心距ee", "slot": "out[78]", "unit": "mm" },
        { "name": "摆线轮1齿宽", "slot": "out[79]", "unit": "mm" },
        { "name": "摆线轮传递总力矩", "slot": "out[83]", "unit": "N·m" },
        { "name": "一级输入力矩", "slot": "out[89]", "unit": "N·m" },
