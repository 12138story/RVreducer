<Window x:Class="BingdingTest.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:BingdingTest"
        mc:Ignorable="d"
        Title="TextBox绑定字符串依赖属性 - 支持点号输入" 
        Height="450" Width="800">
    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Margin" Value="0,5"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Margin" Value="0,5,0,15"/>
            <Setter Property="Padding" Value="5"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>

        <Style TargetType="Button">
            <Setter Property="Margin" Value="0,10"/>
            <Setter Property="Padding" Value="8,3"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="将TextBox绑定到后台String依赖属性" 
                   FontSize="18" FontWeight="Bold" Margin="0,0,0,15" 
                   HorizontalAlignment="Center"/>

        <!-- 基本绑定 -->
        <TextBlock Grid.Row="1" Text="基本绑定（支持点号）："/>
        <TextBox Name="TestBox"
                 Grid.Row="2" 
                 ToolTip="此文本框绑定到String属性，默认支持输入点号"/>

        <!-- 验证绑定 -->
        <TextBlock Grid.Row="3" Text="验证输入（允许数字和点号）："/>
        <TextBox Grid.Row="4" 
                 ToolTip="此文本框使用事件验证，只允许输入数字和小数点"/>

        <!-- 显示结果 -->
        <Border Grid.Row="5" Margin="0,15" Padding="10" Background="#FFF0F8FF" 
                CornerRadius="5" BorderThickness="1" BorderBrush="#FFADD8E6">
            <StackPanel>
                <TextBlock Text="绑定结果" FontWeight="Bold" HorizontalAlignment="Center"/>
                <TextBlock Margin="0,15" Text="基本绑定值:"/>
                <TextBox Name="DisplayBox" />

            </StackPanel>
        </Border>

        <!--<Button Grid.Row="6" Content="重置绑定值" Click="ResetButton_Click"
                HorizontalAlignment="Center" Padding="20,5"/>-->
    </Grid>
</Window>