      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:RVReducerDesignApp"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="BearingRecommondPage">

    <Grid>
        <ListView x:Name="BearingListView" Margin="10" MouseDoubleClick="BearingListView_MouseDoubleClick">
