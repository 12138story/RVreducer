<Window x:Class="WPFBearings.BearingDataWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WPFBearings"
        xmlns:hc ="https://handyorg.github.io/handycontrol"
        mc:Ignorable="d" WindowStartupLocation="CenterScreen"
        Title="轴承数据查询" Height="400" Width="800">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition/>
            <ColumnDefinition/>
            <ColumnDefinition/>
            <ColumnDefinition/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Grid.Column="2" Grid.ColumnSpan="3" Grid.RowSpan="2" Margin="10,10,10,10" BorderBrush="LightGray" BorderThickness="1" CornerRadius="10" Padding="5">
            <Grid x:Name="Wselectgrid">
                <!-- 保持原有的 Wselectgrid 内容不变 -->
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition/>
                    <RowDefinition/>
                    <RowDefinition/>
                </Grid.RowDefinitions>
                <CheckBox x:Name="Woutsidediameter" Content="外径区间(mm)：" Grid.Row="0" Grid.Column="0" HorizontalAlignment="Left" VerticalAlignment="Center" Checked="Woutsidediameter_checked" Unchecked="Woutsidediameter_Unchecked" />
                <CheckBox x:Name="Winnerdiameter" Content="内径区间(mm)：" Grid.Row="1" Grid.Column="0" HorizontalAlignment="Left" VerticalAlignment="Center" Checked="Winnerdiameter_checked" Unchecked="Winnerdiameter_Unchecked"/>
                <CheckBox x:Name="Wdynamicloads" Content="Cr区间(N)：" Grid.Row="2" Grid.Column="0" HorizontalAlignment="Left" VerticalAlignment="Center" Checked="Wdynamicloads_checked" Unchecked="Wdynamicloads_Unchecked"/>
                <TextBox x:Name="Wminoutsidediameter" Grid.Row="0" Grid.Column="1" Width="70" Height="30" IsEnabled="False"/>
                <TextBox x:Name="Wmaxoutsidediameter" Grid.Row="0" Grid.Column="2" Width="70" Height="30" IsEnabled="False"/>
                <TextBox x:Name="Wmininnerdiameter" Grid.Row="1" Grid.Column="1" Width="70" Height="30" IsEnabled="False"/>
                <TextBox x:Name="Wmaxinnerdiameter" Grid.Row="1" Grid.Column="2" Width="70" Height="30" IsEnabled="False"/>
                <TextBox x:Name="Wmindynamicloads" Grid.Row="2" Grid.Column="1" Width="70" Height="30" IsEnabled="False"/>
                <TextBox x:Name="Wmaxdynamicloads" Grid.Row="2" Grid.Column="2" Width="70" Height="30" IsEnabled="False"/>
            </Grid>
        </Border>
        <DataGrid x:Name="Wdatalist" AutoGenerateColumns="True" Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="5" Grid.RowSpan="3" Background="White" Margin="10,10,10,10" hc:BorderElement.CornerRadius="10"/>
        <Border Grid.Row="0" Grid.Column="0" Grid.RowSpan="2" Grid.ColumnSpan="2" >
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <ListBox x:Name="Wlistbox" SelectionMode="Single" SelectionChanged="SelectTable"
                         Grid.Row="0" Grid.Column="0" Grid.RowSpan="2" Grid.ColumnSpan="2"
                         Margin="10,10,10,10" hc:BorderElement.CornerRadius="10"/>

                <!-- 切换按钮区域：放在第3列 -->
                <!-- 外层套一个Border，实现类似图片的整体外边框和圆角 -->
                <Border Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Center"
                        BorderBrush="LightGray" BorderThickness="1" CornerRadius="4" Width="80">
                    <StackPanel>
                        <StackPanel.Resources>
                            <!-- 定义单选按钮的无点（无圆形图标）样式 -->
                            <Style TargetType="RadioButton">
                                <Setter Property="Foreground" Value="Gray"/>
                                <!-- 默认灰色 -->
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Height" Value="36"/>
                                <Setter Property="FontSize" Value="14"/>
                                <Setter Property="Cursor" Value="Hand"/>
                                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                <Setter Property="VerticalContentAlignment" Value="Center"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="RadioButton">
                                            <!-- 使用 Border 替换掉原本自带圆点的样式 -->
                                            <Border Background="{TemplateBinding Background}"
                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                    BorderThickness="{TemplateBinding BorderThickness}">
                                                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <!-- 选中时的状态：变黑加粗 -->
                                    <Trigger Property="IsChecked" Value="True">
                                        <Setter Property="Foreground" Value="White"/>
                                        <Setter Property="FontWeight" Value="Bold"/>
                                        <!-- 可选：加一点浅色背景来更好区分选中状态 -->
                                        <Setter Property="Background" Value="#FF326CF3"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Resources>

                        <!-- 第1组按钮，底部加一条横线(0,0,0,1)作为与下方按钮的分割线 -->
                        <RadioButton x:Name="RbGroup1" Content="手册数据" GroupName="DataGroups" IsChecked="True" 
                                     Checked="RbGroup_Checked"
                                     BorderBrush="LightGray" BorderThickness="0,0,0,1"/>

                        <!-- 第2组按钮，无边框 -->
                        <RadioButton x:Name="RbGroup2" Content="Romax数据" GroupName="DataGroups" 
                                     Checked="RbGroup_Checked"
                                     BorderBrush="LightGray" BorderThickness="0,0,0,1"/>
                        <!-- 第2组按钮，无边框 -->
                        <RadioButton x:Name="RbGroup3" Content="自定义轴承" GroupName="DataGroups" 
                                     Checked="RbGroup_Checked"
                                     BorderThickness="0"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
        <Frame x:Name="Pdrawbeams" HorizontalAlignment="Center" VerticalAlignment="Center" Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="6" Grid.RowSpan="5"/>
        <Button x:Name="Add" Content="添加" Grid.Column="5" Grid.Row="1" Width="70" Height="40" Click="Add_Click"   Foreground="Black" BorderBrush="LightGray" BorderThickness="1" hc:BorderElement.CornerRadius="10"/>
        <Button x:Name="Revise" Content="修改" Grid.Column="5" Grid.Row="2" Width="70" Height="40" Click="Revise_Click"   Foreground="Black" BorderBrush="LightGray" BorderThickness="1" hc:BorderElement.CornerRadius="10"/>
        <Button x:Name="Delete" Content="删除" Grid.Column="5" Grid.Row="3" Width="70" Height="40" Click="Delete_Click"   Foreground="Black" BorderBrush="LightGray" BorderThickness="1" hc:BorderElement.CornerRadius="10"/>
        <Button x:Name="Refresh" Content="导出" Grid.Column="5" Grid.Row="4" Width="70" Height="40" Click="Export_Click"   Foreground="Black" BorderBrush="LightGray" BorderThickness="1" hc:BorderElement.CornerRadius="10"/>
        <Button x:Name="Wdrawbeams" Content="确定" Grid.Column="5" Grid.Row="0" Width="70" Height="40" Click="Wdrawbeams_Click"  BorderBrush="LightGray" BorderThickness="1" hc:BorderElement.CornerRadius="10"/>
    </Grid>
</Window>